# ============================================================
# accommodation-service Environment Configuration (.env.example)
# ============================================================

# Database MySQL 8.4 LTS (Root & Isolated Per-Service Least-Privilege Users)
DB_HOST=localhost
DB_PORT=5555
DB_USER=root
DB_PASSWORD=REPLACE_WITH_ROOT_DB_PASSWORD
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=REPLACE_WITH_IDENTITY_DB_PASSWORD
LISTING_DB_USER=listing_user
LISTING_DB_PASSWORD=REPLACE_WITH_LISTING_DB_PASSWORD
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=REPLACE_WITH_BOOKING_DB_PASSWORD
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=REPLACE_WITH_BILLING_DB_PASSWORD
COMMUNICATION_DB_USER=communication_user
COMMUNICATION_DB_PASSWORD=REPLACE_WITH_COMM_DB_PASSWORD
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=REPLACE_WITH_ADMIN_DB_PASSWORD

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6380

# RabbitMQ Broker (BROKER-01)
RABBITMQ_USER=cozynest
RABBITMQ_PASSWORD=REPLACE_WITH_RABBITMQ_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# JWT RS256 (Keypair asymmetric signing in identity-service, JWKS verified by downstream services; no HMAC JWT_SECRET)

# Service URLs for API Gateway
IDENTITY_SERVICE_URL=http://localhost:8081
LISTING_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083
BILLING_SERVICE_URL=http://localhost:8084
COMMUNICATION_SERVICE_URL=http://localhost:8085
ADMIN_SERVICE_URL=http://localhost:8086

# ============================================================
# Cấu hình Xác thực sinh trắc học khuôn mặt KYC-02
# ============================================================
# Bật tính năng xác thực khuôn mặt (true / false)
FACE_VERIFICATION_ENABLED=true

# Nhà cung cấp đối soát khuôn mặt: 'manual' (kiểm duyệt viên thủ công - mặc định) hoặc 'vendor' (gọi eKYC ngoài)
FACE_PROVIDER=manual

# Điều kiện KYC tổng thể: bắt buộc khuôn mặt PASSED để hoàn tất KYC và đăng tin (true / false)
FACE_REQUIRED=true

# Thời hạn lưu trữ khung hình sinh trắc học đã có quyết định (ngày, mặc định 30 ngày)
FACE_RETENTION_DAYS=30

# Số lần thử tối đa trong vòng 24 giờ cho mỗi tài khoản (chống spam/dò)
FACE_MAX_ATTEMPTS_PER_DAY=3

# Tự động dọn dẹp xóa ảnh sinh trắc học quá hạn (mặc định tắt ở dev để kiểm tra)
FACE_CLEANUP_ENABLED=false

# Khóa mã hóa AES-GCM 256-bit (32 bytes base64) bảo vệ ảnh sinh trắc học.
# Lệnh tạo khóa: openssl rand -base64 32 hoặc PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# BẮT BUỘC có giá trị thật trên production (thiếu -> ứng dụng từ chối khởi động)
FACE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# Địa chỉ API nhà cung cấp eKYC ngoài (nếu dùng FACE_PROVIDER=vendor)
FACE_VENDOR_BASE_URL=REPLACE_IF_USING_VENDOR

# Khóa API nhà cung cấp eKYC ngoài (nếu dùng FACE_PROVIDER=vendor)
FACE_VENDOR_API_KEY=REPLACE_IF_USING_VENDOR

# ============================================================
# Cấu hình Đăng nhập Google (AUTH-02)
# ============================================================
# Bật tính năng đăng nhập bằng Google (true / false)
GOOGLE_LOGIN_ENABLED=false

# Google OAuth 2.0 Web Client ID (dạng: xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com)
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# LƯU Ý BẢO MẬT: Luồng Google Identity Services dùng ID token xác thực qua JWKS công khai.
# TUYỆT ĐỐI KHÔNG CẦN VÀ KHÔNG DÙNG Client Secret (GOOGLE_CLIENT_SECRET).
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
# Cho phép tài khoản nhân sự (ADMIN, MODERATOR) đăng nhập qua Google (mặc định false vì lý do an ninh)
GOOGLE_ALLOW_STAFF=false

# ============================================================
# Cấu hình Gửi Email SMTP Thật (AUTH-UI / OTP)
# ============================================================
# Máy chủ SMTP (vd: smtp.gmail.com, smtp.resend.com, mail.privateemail.com; Dev mặc định dùng Mailpit localhost:1025)
MAIL_HOST=smtp.gmail.com

# Cổng kết nối SMTP (thường là 587 cho STARTTLS hoặc 465 cho SSL; Dev Mailpit dùng 1025)
MAIL_PORT=587

# Tên đăng nhập tài khoản SMTP (thường là địa chỉ email gửi đi)
MAIL_USERNAME=your-email@gmail.com

# Mật khẩu ứng dụng (App Password 16 ký tự - TUYỆT ĐỐI KHÔNG dùng mật khẩu chính của tài khoản email)
MAIL_PASSWORD=REPLACE_WITH_APP_PASSWORD

# Địa chỉ email hiển thị ở mục Người gửi (From) - nên là địa chỉ đã xác minh để tránh rơi vào hòm thư rác
MAIL_FROM=no-reply@cozynest.vn

# Tên thương hiệu hiển thị bên cạnh địa chỉ email người gửi
MAIL_FROM_NAME="Tổ Ấm"

# Bật xác thực SMTP (true với máy chủ SMTP thật; false với Mailpit ở môi trường dev)
MAIL_SMTP_AUTH=true

# Bật mã hóa kết nối bảo mật STARTTLS (true với cổng 587; false với Mailpit ở môi trường dev)
MAIL_SMTP_STARTTLS=true

# Bật/tắt gửi email thực tế (production thiếu cấu hình hoặc false sẽ trả HTTP 503 ở luồng quên mật khẩu; Dev Mailpit đặt true)
MAIL_ENABLED=false



