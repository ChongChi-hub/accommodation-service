# ============================================================
# accommodation-service Production & Local Env (.env.example)
# Copy to .env on VPS (/opt/cozynest/.env) and fill real values
# NEVER commit .env to Git!
# ============================================================

# Container Registry & Release Tag (GHCR)
GHCR_OWNER=chongchi-hub
IMAGE_TAG=latest

# Domain & CORS
APP_DOMAIN=https://cozynestvvip.duckdns.org
CORS_ALLOWED_ORIGINS=https://cozynestvvip.duckdns.org,http://localhost:3000
SPRING_PROFILES_ACTIVE=prod
SWAGGER_ENABLED=false

# Internal Service-to-Service Auth Key (generate with: openssl rand -hex 32)
INTERNAL_SERVICE_KEY=REPLACE_WITH_INTERNAL_SERVICE_KEY

# Database MySQL 8.4 LTS (Isolated Per-Service Users)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=REPLACE_WITH_STRONG_ROOT_DB_PASSWORD
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=REPLACE_WITH_IDENTITY_DB_PASSWORD
LISTING_DB_USER=listing_user
LISTING_DB_PASSWORD=REPLACE_WITH_LISTING_DB_PASSWORD
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=REPLACE_WITH_BOOKING_DB_PASSWORD
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=REPLACE_WITH_BILLING_DB_PASSWORD
COMMUNICATION_DB_USER=communication_user
COMMUNICATION_DB_PASSWORD=REPLACE_WITH_COMM_DB_PASSWORD
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=REPLACE_WITH_ADMIN_DB_PASSWORD

# Redis & RabbitMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
RABBITMQ_USER=cozynest
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_RABBITMQ_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
COZYNEST_BROKER_ENABLED=true

# Storage (local persistent volumes on VPS or S3/R2)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BUCKET=cozynest-public
S3_PRIVATE_BUCKET=cozynest-private
S3_PUBLIC_CDN_URL=https://cozynestvvip.duckdns.org/api/v1/media

# Fintech / Wallet / Platform Bank (billing-service)
FINTECH_MODE=LIVE
FINTECH_WEBHOOK_AUTO_VERIFY_ENABLED=false
FINTECH_PAYOUT_REQUIRE_OTP=false
DEPOSIT_RELEASE_PERCENT=50
COMMISSION_PERCENT=5
WITHDRAWAL_HOLD_DAYS=3
PAYMENT_PROOF_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
PLATFORM_BANK_CODE=VCB
PLATFORM_BANK_NAME=Vietcombank
PLATFORM_BANK_ACCOUNT=REPLACE_WITH_PLATFORM_ACCOUNT_NUMBER
PLATFORM_BANK_HOLDER=REPLACE_WITH_PLATFORM_ACCOUNT_HOLDER

# Face Verification / eKYC (identity-service)
FACE_VERIFICATION_ENABLED=true
FACE_PROVIDER=manual
FACE_REQUIRED=true
FACE_RETENTION_DAYS=30
FACE_MAX_ATTEMPTS_PER_DAY=3
FACE_CLEANUP_ENABLED=false
# Generate: openssl rand -base64 32
FACE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
FACE_VENDOR_BASE_URL=
FACE_VENDOR_API_KEY=

# Google OAuth 2.0 Web Client ID (public client ID only, NEVER Client Secret)
GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ALLOW_STAFF=false

# Email SMTP / EmailJS (identity-service & communication-service)
MAIL_ENABLED=true
EMAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_EMAIL
MAIL_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
MAIL_FROM=no-reply@cozynestvvip.duckdns.org
MAIL_FROM_NAME=To Am
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_REDIRECT_TO=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID_NOTIFY=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAIL_MONTHLY_CAP=150

# Frontend Next.js Runtime Env (used by web container in docker-compose.prod.yml)
NEXT_PUBLIC_APP_URL=https://cozynestvvip.duckdns.org
NEXT_PUBLIC_API_URL=https://cozynestvvip.duckdns.org/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET
EMAILJS_ACC1_SERVICE_ID=
EMAILJS_ACC1_PUBLIC_KEY=
EMAILJS_ACC1_PRIVATE_KEY=
EMAILJS_TEMPLATE_REGISTER=
EMAILJS_TEMPLATE_VERIFY_EMAIL=
EMAILJS_ACC2_SERVICE_ID=
EMAILJS_ACC2_PUBLIC_KEY=
EMAILJS_ACC2_PRIVATE_KEY=
EMAILJS_TEMPLATE_CHANGE_PASSWORD=
