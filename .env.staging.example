# Staging Environment Template — accommodation-service (Tổ Ấm / CozyNest)
# Copy to .env.staging on deployment host and fill via secrets manager. Never commit real values.

SPRING_PROFILES_ACTIVE=staging

DB_HOST=staging-mysql.internal
DB_PORT=3306
IDENTITY_DB_USER=svc_identity
IDENTITY_DB_PASS=REPLACE_WITH_SECRET
LISTING_DB_USER=svc_listing
LISTING_DB_PASS=REPLACE_WITH_SECRET
BOOKING_DB_USER=svc_booking
BOOKING_DB_PASS=REPLACE_WITH_SECRET
BILLING_DB_USER=svc_billing
BILLING_DB_PASS=REPLACE_WITH_SECRET
COMM_DB_USER=svc_comm
COMM_DB_PASS=REPLACE_WITH_SECRET
ADMIN_DB_USER=svc_admin
ADMIN_DB_PASS=REPLACE_WITH_SECRET

REDIS_HOST=staging-redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_SECRET

JWT_ISSUER=cozynest-identity
JWT_AUDIENCE=cozynest-web
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem

INTERNAL_SERVICE_KEY=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
STORAGE_HMAC_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
STORAGE_AES_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

CORS_ALLOWED_ORIGINS=https://staging.toam.vn
SWAGGER_ENABLED=false

# LEGAL-02 Mandatory Sandbox Gate (MUST remain false until licensed partner + counsel sign-off)
FINTECH_MODE=SANDBOX_ONLY
FINTECH_LIVE_CUSTODY_ENABLED=false
FINTECH_LIVE_DISBURSEMENT_ENABLED=false
PAYMENT_GATEWAY_KILL_SWITCH=false
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_SANDBOX_WEBHOOK_SECRET
PAYMENT_WEBHOOK_ALLOWED_IPS=127.0.0.1,10.0.0.0/8

MAIL_HOST=smtp.staging.internal
MAIL_PORT=587
MAIL_USER=no-reply@staging.toam.vn
MAIL_PASS=REPLACE_WITH_SECRET

