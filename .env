# ============================================================
# Cấu hình biến môi trường Production (.env)
# ============================================================

# Cấu hình Database MySQL (Port 3306)
DB_ROOT_PASSWORD=rootpassword123
DB_NAME=room_rental
DB_USER=phongtro_user
DB_PASSWORD=phongtro_pass123
DB_PORT=3306
DB_HOST=mysql

# Cấu hình JWT Token (Chuỗi bí mật tối thiểu 256-bit / 32 ký tự)
JWT_SECRET=phongtro_super_secret_jwt_key_min_32_characters_for_hmac256_production_safe!

# Cấu hình CORS (Địa chỉ Frontend, ví dụ: http://localhost:5173 hoặc * để cho phép tất cả)
CORS_ORIGIN=*

# Cấu hình Cổng Backend Spring Boot (Port 8085)
PORT=8085

